# Track source and documentation explicitly; keep firmware and private data local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/android81/
!/analysis/
!/kaios31/

/android81/*
!/android81/.gitignore
!/android81/*.py
!/android81/*.sh
!/android81/*.ps1
!/android81/*.c
!/android81/*.md
!/android81/leo-adreno-init.rc
!/android81/device/
!/android81/shell/
!/android81/screenshots/
!/android81/radio-runtime/
!/android81/audio-runtime/
!/android81/audio-test/
/android81/device/**/local/
/android81/device/**/prebuilt/

/analysis/*
!/analysis/*.py
!/analysis/*.sh
/kaios31/*
!/kaios31/*.py
!/kaios31/*.sh
!/kaios31/*.md
!/kaios31/*.S
!/kaios31/*.fragment

**/__pycache__/
*.pyc
*.log
*.img
*.bin
*.so
*.apk
*.zip
*.gz
*.xz
**/adb_keys
**/adbkey*
*.pem
*.key
